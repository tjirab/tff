version: 1
project_name: minimal_dbt_project

layers:
  order: [staging, intermediate, marts]

checks:
  layer_integrity:
    enabled: true
  dependency_graph:
    enabled: true
    fan_out_warn: 10
    fan_in_warn: 10

rules:
  ban_select_star:
    enabled: true
  no_positional_group_by_or_order_by:
    enabled: true
